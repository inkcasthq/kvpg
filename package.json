{
  "name": "kvpg-workspace",
  "private": true,
  "description": "Workspace of kvpg, a key-value cache in PostgreSQL for Node.js",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc --build packages/kvpg",
    "check": "tsc --build packages/kvpg --force",
    "test": "node --test test/telemetry/*.test.mjs"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "ajv": "8.20.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
