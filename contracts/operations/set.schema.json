{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/inkcasthq/kvpg/main/contracts/operations/set.schema.json",
  "title": "kvpg contract v1: set",
  "description": "Rules S2, S4 and S6. True after a write. False when ifAbsent met a live entry.",
  "$defs": {
    "input": {
      "description": "The arguments, in order.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "../common.schema.json#/$defs/key"
        },
        {
          "$ref": "../common.schema.json#/$defs/value"
        },
        {
          "$ref": "../common.schema.json#/$defs/setOptions"
        }
      ],
      "minItems": 2,
      "items": false
    },
    "result": {
      "type": "boolean"
    },
    "error": {
      "description": "The KvError of a failure. The cause stays with the caller and is not part of the payload (S13).",
      "type": "object",
      "properties": {
        "name": {
          "const": "KvError"
        },
        "code": {
          "enum": [
            "invalid_key",
            "invalid_ttl",
            "invalid_value",
            "value_too_large",
            "driver",
            "closed"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
